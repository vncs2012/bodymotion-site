# Preencha somente quando os endpoints estiverem publicados.
# Sem VITE_API_BASE_URL o formulário usa fallback por e-mail.
VITE_API_BASE_URL=
VITE_LEAD_ENDPOINT=/commercial/leads

# URL do app autenticado para início de trial/checkout.
# Quando configurado, os CTAs de planos redirecionam para esta URL com
# ?plan=<slug>&planId=<id>&billing=monthly|annual&successUrl=...&cancelUrl=...
# O app deve usar planId para chamar POST /payment/checkout e redirecionar
# o usuário ao checkout do Stripe.
VITE_TRIAL_START_URL=

# Chave pública Stripe (pk_test_... para sandbox, pk_live_... para produção)
# Necessária se quiser Stripe Elements inline no site no futuro.
VITE_STRIPE_PUBLIC_KEY=
